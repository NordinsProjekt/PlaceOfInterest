@using System.ComponentModel.DataAnnotations
<div class="form-group">
    <RadzenRow>
        <RadzenColumn Size="4">
            <RadzenRow>
                <p>@Title</p>
            </RadzenRow>
        </RadzenColumn>
        <RadzenRow>
            @ChildContent
        </RadzenRow>
        <RadzenColumn Size="8">

        </RadzenColumn>
    </RadzenRow>
</div>

@code {
    [Parameter] [Required] public RenderFragment ChildContent { get; set; }
    [Parameter] public string Title { get; set; } = "";
}