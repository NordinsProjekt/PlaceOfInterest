@using PlaceOfInterest.Application.UseCases.UpdateEndLocation
<h3>Update End Location</h3>

<EditForm EditContext="EditContext" OnValidSubmit="HandleValidSubmit">
    <FluentValidationValidator />
    <ValidationSummary />
    <div class="form-group">
        <label for="name">Name</label>
        <InputText id="name" class="form-control" @bind-Value="UpdateEndLocationRequest.Name" />
    </div>
    <div class="form-group">
        <label for="description">Description</label>
        <InputTextArea id="description" class="form-control" @bind-Value="UpdateEndLocationRequest.Description" />
    </div>
    <div class="form-group">
        <label for="city">City</label>
        <InputText id="city" class="form-control" @bind-Value="UpdateEndLocationRequest.City" />
    </div>
    <div class="form-group">
        <label for="country">Country</label>
        <InputText id="country" class="form-control" @bind-Value="UpdateEndLocationRequest.Country" />
    </div>
    <div class="form-group">
        <label for="location">Location</label>
        <InputText id="location" class="form-control" @bind-Value="UpdateEndLocationRequest.Location" />
    </div>

    <div class="form-group">
        <label for="location">Verified</label>
        <RadzenCheckBox TValue="bool" id="verified" class="form-control" @bind-Value="UpdateEndLocationRequest.Verified" />
    </div>

    <button type="submit" class="btn btn-primary">Submit</button>
</EditForm>

@code {
    [Inject] public DialogService DialogService { get; set; }
    [Inject] public IMediator Mediator { get; set; }
    [Inject] public IRepository<EndLocation> Repository { get; set; }

    [Parameter] public Guid Id { get; set; }

    private UpdateEndLocationRequest UpdateEndLocationRequest { get; set; } = new();
    private EditContext EditContext { get; set; }


    protected override async Task OnInitializedAsync()
    {
        var endLocation = await Repository.GetByIdAsync(Id);
        UpdateEndLocationRequest = endLocation.ToUpdateRequest();

        EditContext = new EditContext(UpdateEndLocationRequest);
    }

    private async Task HandleValidSubmit()
    {
        await Mediator.Send(UpdateEndLocationRequest);
        await DialogService.CloseSideAsync();
    }
}