@rendermode InteractiveServer

<h3>Start Location CRUD</h3>

<RadzenButton Click="CreateStartLocation" Text="Skapa"/>
@if (DataList.Any())
{
    <RadzenDataGrid TItem="StartLocationListItemDto" Data="DataList" AllowSorting="true">
        <Columns>
            <RadzenDataGridColumn Property="Name" Title="Namn"/>
            <RadzenDataGridColumn Property="Description" Title="Beskrivning" MaxWidth="100"/>
            <RadzenDataGridColumn Property="City" Title="Stad"/>
            <RadzenDataGridColumn Property="Country" Title="Land"/>
            <RadzenDataGridColumn Property="Created" Title="Skapad"/>
            <RadzenDataGridColumn Property="Verified" Title="Verifierad"/>
            <RadzenDataGridColumn Title="Action">
                <Template>
                    <RadzenIcon Icon="delete" @onclick="() => DeleteStartLocation(context.Id)" />
                    <RadzenIcon Icon="update" @onclick="() => UpdateStartLocation(context.Id)"/>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
else
{
    <p>Didn´t found any start locations</p>
}

@code {
    [Inject] public IRepository<StartLocation> Repo { get; set; }
    [Inject] public IMediator Mediator { get; set; }
    [Inject] public DialogService DialogService { get; set; }
    [Inject] public NotificationService NotificationService { get; set; }

    private List<StartLocationListItemDto> DataList { get; set; } = [];


    protected override Task OnInitializedAsync()
    {
        GetLocations();
        return Task.CompletedTask;
    }

    private void GetLocations()
    {
        var selectedLocations = Repo.GetAll<StartLocation, string>(0, 20, x => x.Name);
        DataList = selectedLocations.Select(x => x.ToListItemDto()).ToList();
    }

    private async Task CreateStartLocation()
    {
        await DialogService.OpenSideAsync<CreateStartLocationForm>("");
        GetLocations();
    }

    private async Task DeleteStartLocation(Guid id)
    {
        var delete = await DialogService.Alert("Delete the location?");
        if (delete is true)
        {
            try
            {
                await Mediator.Send(new DeleteStartLocationRequest { Id = id });
                NotificationService.Notify(NotificationSeverity.Info, "Location is deleted", "", 5000);
            }
            catch (Exception)
            {
                NotificationService.Notify(NotificationSeverity.Info, "Location is being used", "", 5000);
            }

            GetLocations();
        }
    }

    private async Task UpdateStartLocation(Guid id)
    {
        await DialogService.OpenSideAsync<UpdateStartLocationForm>("", new Dictionary<string, object> { { "Id", id } });
        GetLocations();
    }
}