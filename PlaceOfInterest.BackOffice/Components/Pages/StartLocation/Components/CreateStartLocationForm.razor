<h3>Create Start Location</h3>

<EditForm EditContext="EditContext" OnValidSubmit="HandleValidSubmit">
    <FluentValidationValidator/>
    <ValidationSummary/>
    <div class="form-group">
        <label for="name">Name</label>
        <InputText id="name" class="form-control" @bind-Value="CreateStartLocationModel.Name"/>
    </div>
    <div class="form-group">
        <label for="description">Description</label>
        <InputTextArea id="description" class="form-control" @bind-Value="CreateStartLocationModel.Description"/>
    </div>
    <div class="form-group">
        <label for="city">City</label>
        <InputText id="city" class="form-control" @bind-Value="CreateStartLocationModel.City"/>
    </div>
    <div class="form-group">
        <label for="country">Country</label>
        <InputText id="country" class="form-control" @bind-Value="CreateStartLocationModel.Country"/>
    </div>
    <div class="form-group">
        <label for="location">Location</label>
        <InputText id="location" class="form-control" @bind-Value="CreateStartLocationModel.Location"/>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</EditForm>

@code {
    [Inject] public DialogService DialogService { get; set; }
    [Inject] public IMediator Mediator { get; set; }

    private CreateStartLocationRequest CreateStartLocationModel { get; set; } = new();
    private EditContext EditContext { get; set; }


    protected override void OnInitialized()
    {
        EditContext = new EditContext(CreateStartLocationModel);
    }

    private async Task HandleValidSubmit()
    {
        await Mediator.Send(CreateStartLocationModel);
        await DialogService.CloseSideAsync();
    }
}