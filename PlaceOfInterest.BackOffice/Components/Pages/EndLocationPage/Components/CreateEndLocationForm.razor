@using global::PlaceOfInterest.Application.UseCases.CreateEndLocation
<h3>Create End Location</h3>

<EditForm EditContext="EditContext" OnValidSubmit="HandleValidSubmit">
    <FluentValidationValidator />
    <ValidationSummary />
    <div class="form-group">
        <label for="name">Name</label>
        <InputText id="name" class="form-control" @bind-Value="CreateEndLocationModel.Name" />
    </div>
    <div class="form-group">
        <label for="description">Description</label>
        <InputTextArea id="description" class="form-control" @bind-Value="CreateEndLocationModel.Description" />
    </div>
    <div class="form-group">
        <label for="city">City</label>
        <InputText id="city" class="form-control" @bind-Value="CreateEndLocationModel.City" />
    </div>
    <div class="form-group">
        <label for="country">Country</label>
        <InputText id="country" class="form-control" @bind-Value="CreateEndLocationModel.Country" />
    </div>
    <div class="form-group">
        <label for="location">Location</label>
        <InputText id="location" class="form-control" @bind-Value="CreateEndLocationModel.Location" />
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</EditForm>

@code {
    [Inject] public DialogService DialogService { get; set; }
    [Inject] public IMediator Mediator { get; set; }

    private CreateEndLocationRequest CreateEndLocationModel { get; } = new();
    private EditContext EditContext { get; set; }


    protected override void OnInitialized()
    {
        EditContext = new EditContext(CreateEndLocationModel);
    }

    private async Task HandleValidSubmit()
    {
        await Mediator.Send(CreateEndLocationModel);
        await DialogService.CloseSideAsync();
    }
}
