@page "/placeofinterest/create"
@using Contracts.Models.Requests
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json
@using ClientWebassembly.Components
@inject PlaceOfInterestApiClient ApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<h2 class="rz-title">Create Place Of Interest</h2>

<div class="alert alert-info mb-4 text-center">
    Please note: Your place must be verified by an admin before it will be visible to others.
</div>

@if (!string.IsNullOrWhiteSpace(createdToken))
{
    <div class="alert alert-success">
        Thank you for your contribution! Your token is: <strong>@createdToken</strong>
    </div>
}

<div class="mb-3 d-flex gap-2">
    <button class="btn btn-outline-secondary btn-sm" @onclick="SaveDraftAsync">Save draft</button>
    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadDraftAsync">Load draft</button>
    <button class="btn btn-outline-danger btn-sm" @onclick="ClearDraftAsync">Clear draft</button>
    @if (lastSavedAt is not null)
    {
        <span class="text-muted small">Last saved: @lastSavedAt</span>
    }
</div>

<EditForm EditContext="@editContext" OnValidSubmit="HandleValidSubmit" class="rz-form">
    <DataAnnotationsValidator />

    <div class="rz-form-group mb-3">
        <label for="name" class="rz-label">Name</label>
        <InputText id="name" class="rz-input form-control" @bind-Value="request.Name" />
        <ValidationMessage For="@(() => request.Name)" class="rz-validation-message text-danger" />
    </div>

    <div class="rz-form-group mb-3">
        <label for="description" class="rz-label">Description</label>
        <InputTextArea id="description" class="rz-input form-control" @bind-Value="request.Description" />
        <ValidationMessage For="@(() => request.Description)" class="rz-validation-message text-danger" />
    </div>

    <div class="rz-form-group mb-3">
        <label for="startLocation" class="rz-label">Start Location</label>
        <div class="input-group">
            <InputText id="startLocation" class="rz-input form-control" @bind-Value="request.StartLocation" />
            <button type="button" class="rz-button btn btn-outline-secondary" disabled="@isGettingStartLocation" @onclick="@(() => GetLocation("startLocation"))">
				<LoadingComponent IsLoading="isGettingStartLocation" LoadingMessage="Getting location......" NotLoadingMessage="Get location"/>
            </button>
        </div>
        <ValidationMessage For="@(() => request.StartLocation)" class="rz-validation-message text-danger" />
    </div>

    <div class="rz-form-group mb-3">
        <label for="endLocation" class="rz-label">End Location</label>
        <div class="input-group">
            <InputText id="endLocation" class="rz-input form-control" @bind-Value="request.EndLocation" />
            <button type="button" class="rz-button btn btn-outline-secondary" disabled="@isGettingEndLocation" @onclick="@(() => GetLocation("endLocation"))">
                <LoadingComponent IsLoading="isGettingEndLocation" LoadingMessage="Getting location......" NotLoadingMessage="Get location" />
            </button>
        </div>
        <ValidationMessage For="@(() => request.EndLocation)" class="rz-validation-message text-danger" />
    </div>

    <div class="rz-form-group mb-3">
        <label for="terrainScore" class="rz-label">Terrain Score</label>
        <InputNumber id="terrainScore" class="rz-input form-control" @bind-Value="request.TerrainScore" min="1" max="5" />
        <ValidationMessage For="@(() => request.TerrainScore)" class="rz-validation-message text-danger" />
    </div>

    <div class="rz-form-group mb-3">
        <label for="imageUrl" class="rz-label">Image URL</label>
        <InputText id="imageUrl" class="rz-input form-control" @bind-Value="request.ImageUrl" />
        <ValidationMessage For="@(() => request.ImageUrl)" class="rz-validation-message text-danger" />
    </div>

    <button type="submit" class="rz-button btn btn-primary" disabled="@isSubmitting">
		<LoadingComponent IsLoading="isSubmitting" LoadingMessage="Submitting...." NotLoadingMessage="Create"/>
    </button>
    <button type="button" class="rz-button btn btn-secondary" @onclick="Cancel" disabled="@isSubmitting">Cancel</button>
</EditForm>

@code {
    private const string DraftKey = "poi:create:draft";
    private const string ContributionsKey = "poi:contributions";
    private CreatePlaceOfInterestApiRequestDto request = new();
    private EditContext? editContext;
    private string? lastSavedAt;
    private string? createdToken;
    private bool isGettingStartLocation;
    private bool isGettingEndLocation;
    private bool isSubmitting;

    protected override void OnInitialized()
    {
        request = new();
        editContext = new EditContext(request);
        editContext.OnFieldChanged += EditContext_OnFieldChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDraftAsync();
        }
    }

    private async void EditContext_OnFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        try { await SaveDraftAsync(); } catch { }
    }

    private async Task SaveDraftAsync()
    {
        var json = JsonSerializer.Serialize(request);
        await JSRuntime.InvokeVoidAsync("storage.set", DraftKey, json);
        lastSavedAt = DateTime.Now.ToString("HH:mm:ss");
        StateHasChanged();
    }

    private async Task<bool> TryLoadDraftAsync()
    {
        var json = await JSRuntime.InvokeAsync<string?>("storage.get", DraftKey);
        if (!string.IsNullOrWhiteSpace(json))
        {
            try
            {
                var draft = JsonSerializer.Deserialize<CreatePlaceOfInterestApiRequestDto>(json!);
                if (draft is not null)
                {
                    request = draft;
                    editContext = new EditContext(request);
                    editContext.OnFieldChanged += EditContext_OnFieldChanged;
                    StateHasChanged();
                    return true;
                }
            }
            catch { }
        }
        return false;
    }

    private async Task LoadDraftAsync()
    {
        var loaded = await TryLoadDraftAsync();
        if (loaded)
        {
            lastSavedAt = "loaded";
        }
    }

    private async Task ClearDraftAsync()
    {
        await JSRuntime.InvokeVoidAsync("storage.remove", DraftKey);
        lastSavedAt = null;
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        StateHasChanged();
        try
        {
            var token = await ApiClient.CreateAsync(request);
            if (!string.IsNullOrWhiteSpace(token))
            {
                createdToken = token;
                await RemoveDraftIfMatchesAsync(request);
                await AddContributionAsync(token!, request.Name);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error creating place of interest: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private class ContributionEntry
    {
        public string Token { get; set; } = string.Empty;
        public string? Name { get; set; }
    }

    private async Task AddContributionAsync(string token, string name)
    {
        var existingJson = await JSRuntime.InvokeAsync<string?>("storage.get", ContributionsKey);
        List<ContributionEntry> entries = new();
        var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

        if (!string.IsNullOrWhiteSpace(existingJson))
        {
            try
            {
                var parsed = JsonSerializer.Deserialize<List<ContributionEntry>>(existingJson!, options);
                if (parsed is not null) entries = parsed;
            }
            catch
            {
                try
                {
                    var tokens = JsonSerializer.Deserialize<List<string>>(existingJson!) ?? new();
                    entries = tokens.Select(t => new ContributionEntry { Token = t }).ToList();
                }
                catch { }
            }
        }

        if (!entries.Any(e => string.Equals(e.Token, token, StringComparison.OrdinalIgnoreCase)))
        {
            entries.Add(new ContributionEntry { Token = token, Name = name });
        }
        else
        {
            var existing = entries.First(e => string.Equals(e.Token, token, StringComparison.OrdinalIgnoreCase));
            if (string.IsNullOrWhiteSpace(existing.Name)) existing.Name = name;
        }

        await JSRuntime.InvokeVoidAsync("storage.set", ContributionsKey, JsonSerializer.Serialize(entries));
    }

    private async Task RemoveDraftIfMatchesAsync(CreatePlaceOfInterestApiRequestDto current)
    {
        var currentJson = JsonSerializer.Serialize(current);
        var storedJson = await JSRuntime.InvokeAsync<string?>("storage.get", DraftKey);
        if (!string.IsNullOrWhiteSpace(storedJson) && string.Equals(storedJson, currentJson, StringComparison.Ordinal))
        {
            await JSRuntime.InvokeVoidAsync("storage.remove", DraftKey);
        }
    }

    private async Task GetLocation(string inputId)
    {
        try
        {
            if (inputId == "startLocation") isGettingStartLocation = true; else if (inputId == "endLocation") isGettingEndLocation = true;
            StateHasChanged();

            var location = await JSRuntime.InvokeAsync<LocationResult>("getCurrentPosition");
            if (inputId == "startLocation")
                request.StartLocation = $"{location.Latitude},{location.Longitude}";
            else if (inputId == "endLocation")
                request.EndLocation = $"{location.Latitude},{location.Longitude}";

            await SaveDraftAsync();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error getting location: {ex.Message}");
        }
        finally
        {
            if (inputId == "startLocation") isGettingStartLocation = false; else if (inputId == "endLocation") isGettingEndLocation = false;
            StateHasChanged();
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/placeofinterest");
    }

    public void Dispose()
    {
        if (editContext is not null)
        {
            editContext.OnFieldChanged -= EditContext_OnFieldChanged;
        }
    }

    private class LocationResult
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
    }
}