@page "/create-place-of-interest"
@using PlaceOfInterest.Application.UseCases.CreatePlaceOfInterest
@using PlaceOfInterest.Client.Client.Services
@using PlaceOfInterest.GoogleMaps
@inject PlaceOfInterestApiClient ApiClient
@inject GoogleMapsService MapsService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<div class="container mt-4">
    <h3>Create Place of Interest</h3>

    <EditForm Model="@request" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <InputText id="name" @bind-Value="request.Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <InputTextArea id="description" @bind-Value="request.Description" class="form-control" />
        </div>

        <div class="row mb-3">
            <div class="col">
                <h4>Start Location</h4>
                <div class="mb-2">
                    <button type="button" class="btn btn-secondary" @onclick="GetCurrentLocationForStart">
                        Use Current Location
                    </button>
                </div>
                <div id="startLocationMap" style="height: 300px; width: 100%;" @ref="startMapElement"></div>
                <div class="mt-2">
                    <label>Selected Location:</label>
                    <input type="text" class="form-control" @bind="request.StartLocation" readonly />
                </div>
            </div>
            <div class="col">
                <h4>End Location</h4>
                <div class="mb-2">
                    <button type="button" class="btn btn-secondary" @onclick="GetCurrentLocationForEnd">
                        Use Current Location
                    </button>
                </div>
                <div id="endLocationMap" style="height: 300px; width: 100%;" @ref="endMapElement"></div>
                <div class="mt-2">
                    <label>Selected Location:</label>
                    <input type="text" class="form-control" @bind="request.EndLocation" readonly />
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label for="terrainScore" class="form-label">Terrain Score (1-5)</label>
            <InputNumber id="terrainScore" @bind-Value="request.TerrainScore" class="form-control" min="1" max="5" />
        </div>

        <div class="mb-3">
            <label for="imageUrl" class="form-label">Image URL</label>
            <InputText id="imageUrl" @bind-Value="request.ImageUrl" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">Create</button>
    </EditForm>
</div>

@code {
    private CreatePlaceOfInterestRequest request = new();
    private ElementReference startMapElement;
    private ElementReference endMapElement;
    private bool mapsInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeMapsAsync();
            mapsInitialized = true;
        }
    }

    private async Task InitializeMapsAsync()
    {
        await JSRuntime.InvokeVoidAsync("initializeMaps", 
            startMapElement, endMapElement,
            DotNetObjectReference.Create(this));
    }

    private async Task GetCurrentLocationForStart()
    {
        try
        {
            var location = await JSRuntime.InvokeAsync<GeolocationResult>("getCurrentPosition");
            var locationInfo = await MapsService.GetLocationFromCoordinatesAsync(location.Latitude, location.Longitude);
            
            if (locationInfo != null)
            {
                request.StartLocation = locationInfo.FormattedAddress;
                await JSRuntime.InvokeVoidAsync("updateStartMarker", location.Latitude, location.Longitude);
            }
        }
        catch (Exception ex)
        {
            // Handle error
            Console.WriteLine(ex);
        }
    }

    private async Task GetCurrentLocationForEnd()
    {
        try
        {
            var location = await JSRuntime.InvokeAsync<GeolocationResult>("getCurrentPosition");
            var locationInfo = await MapsService.GetLocationFromCoordinatesAsync(location.Latitude, location.Longitude);
            
            if (locationInfo != null)
            {
                request.EndLocation = locationInfo.FormattedAddress;
                await JSRuntime.InvokeVoidAsync("updateEndMarker", location.Latitude, location.Longitude);
            }
        }
        catch (Exception ex)
        {
            // Handle error
            Console.WriteLine(ex);
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            request.PublicUniqueToken = Guid.NewGuid().ToString(); // You might want to generate this differently
            var result = await ApiClient.CreateAsync(request);
            if (result)
            {
                Navigation.NavigateTo("/places"); // Navigate to list view
            }
        }
        catch (Exception ex)
        {
            // Handle error
            Console.WriteLine(ex);
        }
    }

    [JSInvokable]
    public async Task OnStartLocationSelected(double lat, double lng)
    {
        var locationInfo = await MapsService.GetLocationFromCoordinatesAsync(lat, lng);
        if (locationInfo != null)
        {
            request.StartLocation = locationInfo.FormattedAddress;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnEndLocationSelected(double lat, double lng)
    {
        var locationInfo = await MapsService.GetLocationFromCoordinatesAsync(lat, lng);
        if (locationInfo != null)
        {
            request.EndLocation = locationInfo.FormattedAddress;
            StateHasChanged();
        }
    }

    public class GeolocationResult
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
    }
}