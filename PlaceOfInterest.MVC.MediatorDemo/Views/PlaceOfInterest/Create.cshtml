@model Contracts.Models.Requests.CreatePlaceOfInterestApiRequestDto
@{
    ViewData["Title"] = "Create Place (Mediator)";
}
<h2>@ViewData["Title"]</h2>
<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="StartLocation" class="form-label"></label>
        <input asp-for="StartLocation" class="form-control" />
        <span asp-validation-for="StartLocation" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="EndLocation" class="form-label"></label>
        <input asp-for="EndLocation" class="form-control" />
        <span asp-validation-for="EndLocation" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TerrainScore" class="form-label"></label>
        <input asp-for="TerrainScore" type="number" class="form-control" />
        <span asp-validation-for="TerrainScore" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ImageUrl" class="form-label"></label>
        <input asp-for="ImageUrl" class="form-control" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>
    <button class="btn btn-primary" type="submit">Save</button>
</form>